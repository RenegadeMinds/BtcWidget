<Window x:Class="BtcWidget.Views.LinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BtcWidget.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LinesViewModel, IsDesignTimeCreatable=True}"
        Title="Lines"
        Width="760" Height="500" MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="#FF202329" Foreground="#FFECEFF4">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#FF9AA3B2" />
        <SolidColorBrush x:Key="Field" Color="#FF2A2E37" />
        <SolidColorBrush x:Key="FieldBorder" Color="#FF3A3F4A" />

        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />

        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=1.08}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Logo" TargetType="Image">
            <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=1.4}" />
            <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=1.4}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>

        <!-- Dark list: no chrome, subtle hover, no hard blue selection -->
        <Style x:Key="DarkList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFECEFF4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter chips: a horizontal ListBox whose items look like pills -->
        <Style x:Key="Chips" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,6,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{StaticResource Field}" BorderBrush="{StaticResource FieldBorder}"
                                            BorderThickness="1" CornerRadius="10" Padding="10,3" Cursor="Hand">
                                        <TextBlock Text="{Binding Label}" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.92}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFF7931A" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFF7931A" />
                                            <Setter Property="Foreground" Value="#FF1B1E26" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9AA3B2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.85}" />
            <Setter Property="Padding" Value="5,3" />
        </Style>

        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Background" Value="#FFF7931A" />
            <Setter Property="Foreground" Value="#FF1B1E26" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFA940" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KindBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Left: current lines ================= -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Your lines" />
            <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Muted}" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.92}" Margin="0,0,0,8"
                       Text="Provider and quote per line. Changes apply to the widget immediately." TextWrapping="Wrap" />
            <ListBox Style="{StaticResource DarkList}" ItemsSource="{Binding Lines}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LineItemViewModel}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Style="{StaticResource Logo}" Source="{Binding LogoUri}" Margin="0,0,8,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{StaticResource Muted}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.85}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                    <ComboBox Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=8.5}" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.92}" ToolTip="Provider"
                                              ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding SelectedProvider}"
                                              DisplayMemberPath="DisplayName" />
                                    <ComboBox Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=5.6}" Margin="4,0,0,0" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.92}" ToolTip="Quote currency. Default = USD for crypto, the listing currency for stocks."
                                              ItemsSource="{Binding QuoteOptions}" SelectedItem="{Binding SelectedQuote}"
                                              DisplayMemberPath="Label" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Bell: toggles the inline alert editor; lit with a count when rules exist -->
                                    <Button ToolTip="Alerts for this line" Command="{Binding ToggleAlertsCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAlerts}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFF7931A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA8F;" />
                                            <TextBlock Text="{Binding AlertCount}" FontFamily="Segoe UI" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.77}" Margin="3,0,0,0"
                                                       Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SmallButton}" Content="&#xE70E;" ToolTip="Move up"
                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource SmallButton}" Content="&#xE70D;" ToolTip="Move down"
                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource SmallButton}" Content="&#xE74D;" ToolTip="Remove"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>

                            <!-- Inline alert editor -->
                            <Border Margin="26,6,0,2" Padding="8,6" Background="{StaticResource Field}" CornerRadius="4"
                                    BorderBrush="{StaticResource FieldBorder}" BorderThickness="1"
                                    Visibility="{Binding ShowAlerts, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="No alerts yet." Foreground="{StaticResource Muted}" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.85}" Margin="0,0,0,6"
                                               Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibilityInverse}}" />
                                    <ItemsControl ItemsSource="{Binding Alerts}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AlertRuleViewModel}">
                                                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="&#xE74D;" ToolTip="Remove alert"
                                                            Command="{Binding DataContext.RemoveAlertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock VerticalAlignment="Center" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.92}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.77}" Foreground="{StaticResource Muted}" /><Run Text="  " /><Run Text="{Binding Text, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding State, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.77}" />
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Add: type, value, Add. Enter in the value box adds. -->
                                    <DockPanel Margin="0,2,0,0" LastChildFill="False">
                                        <ComboBox DockPanel.Dock="Left" Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=10}" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.92}" VerticalAlignment="Center"
                                                  ItemsSource="{Binding AlertTypes}" SelectedItem="{Binding NewAlertType}" DisplayMemberPath="Label" />
                                        <TextBox DockPanel.Dock="Left" Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=6}" Margin="6,0,0,0" Padding="6,3" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.92}" VerticalAlignment="Center"
                                                 Background="#FF202329" Foreground="#FFECEFF4" BorderBrush="{StaticResource FieldBorder}" CaretBrush="#FFECEFF4"
                                                 Text="{Binding NewAlertValue, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding NewAlertNeedsValue, Converter={StaticResource BoolToVisibility}}"
                                                 ToolTip="Price (110000, 110k) or percent (5)">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddAlertCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding NewAlertUnit}" Foreground="{StaticResource Muted}" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.92}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource AddButton}" Content="Add" VerticalAlignment="Center"
                                                Command="{Binding AddAlertCommand}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource FieldBorder}" HorizontalAlignment="Center" Margin="0,4" />

        <!-- ================= Right: search and add ================= -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Add a line" />

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                <ComboBox DockPanel.Dock="Right" Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=6.5}" Margin="8,0,0,0" VerticalAlignment="Stretch"
                          ToolTip="Quote currency for lines you add. Default = USD for crypto, the listing currency for stocks. Or type a pair: BTC/CAD, ETHBTC."
                          ItemsSource="{Binding QuoteOptions}" SelectedItem="{Binding SelectedQuote}" DisplayMemberPath="Label" />
                <TextBox x:Name="SearchBox" Padding="8,5"
                         Background="{StaticResource Field}" Foreground="#FFECEFF4" BorderBrush="{StaticResource FieldBorder}"
                         CaretBrush="#FFECEFF4"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Type a name, ticker or pair: tesla, shopify, xrp, BTC/CAD, ETHBTC, gold, ^VIX, EURUSD=X" />
            </DockPanel>

            <ListBox DockPanel.Dock="Top" Style="{StaticResource Chips}" ItemsSource="{Binding Filters}"
                     SelectedItem="{Binding SelectedFilter}" />

            <DockPanel DockPanel.Dock="Top" Margin="0,2,0,6">
                <ProgressBar DockPanel.Dock="Right" Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=4.6}" Height="4" IsIndeterminate="{Binding IsBusy}" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ResultsHeader}" Foreground="{StaticResource Muted}" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.92}" />
            </DockPanel>

            <ListBox Style="{StaticResource DarkList}" ItemsSource="{Binding Results}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SearchResultViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Logo if we have one, otherwise a letter disc -->
                            <Grid Grid.Column="0" Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=1.4}" Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=1.4}" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Fill="{StaticResource Field}" Stroke="{StaticResource FieldBorder}" />
                                <TextBlock Text="{Binding Initial}" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.77}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Style="{StaticResource Logo}" Source="{Binding LogoUri}"
                                       Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.85}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource KindBadge}">
                                <TextBlock Text="{Binding KindLabel}" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.77}" Foreground="{StaticResource Muted}" />
                            </Border>

                            <Button Grid.Column="3" Style="{StaticResource AddButton}" Content="Add" VerticalAlignment="Center"
                                    Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Button Grid.Row="1" Grid.Column="2" Content="Close" IsCancel="True" IsDefault="False"
                HorizontalAlignment="Right" Padding="16,4" Margin="0,12,0,0" />
    </Grid>
</Window>
