<Window x:Class="BtcWidget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BtcWidget.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
        Title="Widget settings"
        SizeToContent="WidthAndHeight" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontSize="{Binding FontSize}"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="#FF202329" Foreground="#FFECEFF4">

    <!--
        Three columns everywhere: label | control | value. Every control starts at the same x and every
        value ends at the same x. The dialog's font follows the widget's Font size setting, so what you
        set is what you read here too. Changes apply live and persist automatically.
    -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Foreground" Value="#FF9AA3B2" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9AA3B2" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <!-- The window sizes to content, so wrapped text needs a width of its own or it sets the window's -->
            <Setter Property="MaxWidth" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=30}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,2,0,6" />
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.85}" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF7931A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.85}" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="0.05" />
            <Setter Property="Minimum" Value="0.1" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="MinWidth" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=14}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFECEFF4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#FF2A2E37" />
            <Setter Property="Foreground" Value="#FFECEFF4" />
            <Setter Property="BorderBrush" Value="#FF3A3F4A" />
            <Setter Property="CaretBrush" Value="#FFECEFF4" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
        <!-- Collapsible sector section: a chevron and a header line, no chrome -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="#FFECEFF4" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left"
                                          Foreground="{TemplateBinding Foreground}" Padding="2,4" FocusVisualStyle="{x:Null}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF9AA3B2" RenderTransformOrigin="0.5,0.5"
                                                           FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.7}">
                                                    <TextBlock.RenderTransform><RotateTransform Angle="0" /></TextBlock.RenderTransform>
                                                </TextBlock>
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" />
                            </ToggleButton>
                            <ContentPresenter x:Name="Content" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Content" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A TextBox that looks like text until you point at it -->
        <Style x:Key="InlineEdit" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF3A3F4A" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#FF2A2E37" />
                    <Setter Property="BorderBrush" Value="#FF9AA3B2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2E37" />
            <Setter Property="Foreground" Value="#FFECEFF4" />
            <Setter Property="BorderBrush" Value="#FF3A3F4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9AA3B2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="20,12,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" MinWidth="56" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Appearance -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource Section}" Text="APPEARANCE" Margin="0,0,0,4" />

        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Widget opacity" />
        <Slider    Grid.Row="1" Grid.Column="1" Value="{Binding WindowOpacity}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding WindowOpacity, StringFormat={}{0:P0}}" />

        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Text opacity" />
        <Slider    Grid.Row="2" Grid.Column="1" Value="{Binding TextOpacity}" />
        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding TextOpacity, StringFormat={}{0:P0}}" />

        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Font size" />
        <Slider    Grid.Row="3" Grid.Column="1" Value="{Binding FontSize}" Minimum="10" Maximum="28" TickFrequency="1" />
        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding FontSize, StringFormat={}{0:0} px}" />

        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Width" ToolTip="You can also drag the widget's left or right edge." />
        <Slider    Grid.Row="4" Grid.Column="1" Value="{Binding WindowWidth}" Minimum="220" Maximum="1600" TickFrequency="10" />
        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding WindowWidth, StringFormat={}{0:0} px}" />

        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="List height" ToolTip="The list scrolls beyond this height. 0 = grow with the content. You can also drag the widget's bottom edge." />
        <Slider    Grid.Row="5" Grid.Column="1" Value="{Binding ListHeight}" Minimum="0" Maximum="1200" TickFrequency="20" />
        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding ListHeight, Converter={StaticResource ListHeightText}}" />

        <CheckBox  Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Content="Sparkline, 7d / 30d and range under each line" IsChecked="{Binding ShowDetails}" />
        <CheckBox  Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Content="Tooltips when hovering the widget" IsChecked="{Binding ShowTooltips}" />

        <!-- Behaviour -->
        <TextBlock Grid.Row="8" Grid.ColumnSpan="3" Style="{StaticResource Section}" Text="BEHAVIOUR" />

        <TextBlock Grid.Row="9" Style="{StaticResource Label}" Text="Poll every" />
        <TextBox   Grid.Row="9" Grid.Column="1" Text="{Binding PollIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource Value}" Text="minutes" TextAlignment="Left" />

        <TextBlock Grid.Row="10" Style="{StaticResource Label}" Text="Lines with alerts every" ToolTip="A line polls this often while it has an alert switched on, so a crossing is caught within minutes." />
        <TextBox   Grid.Row="10" Grid.Column="1" Text="{Binding AlertPollMinutes, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource Value}" Text="minutes" TextAlignment="Left" />

        <TextBlock Grid.Row="11" Style="{StaticResource Label}" Text="Come back after" ToolTip="When you minimize the widget it reappears on its own after this long, without taking focus from what you are doing. 0 = stays minimized." />
        <TextBox   Grid.Row="11" Grid.Column="1" Text="{Binding RestoreAfterMinutes, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="11" Grid.Column="2" Style="{StaticResource Value}" Text="minutes (0 = never)" TextAlignment="Left" />
        <CheckBox  Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Content="Come back when an alert fires" IsChecked="{Binding RestoreOnAlert}"
                   ToolTip="Each alert can override this in the Alerts dialog (show widget: default / yes / no). Never takes focus." />
        <CheckBox  Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" Content="Start with Windows" IsChecked="{Binding StartWithWindows}"
                   ToolTip="Adds or removes a startup entry for this exe under your user account (HKCU Run)." />
        <TextBlock Grid.Row="14" Style="{StaticResource Label}" Text="Title-bar ✕" />
        <ComboBox  Grid.Row="14" Grid.Column="1" ItemsSource="{Binding CloseOptions}" SelectedValue="{Binding CloseButtonAction}"
                   SelectedValuePath="Id" DisplayMemberPath="DisplayName" ToolTip="Exit is always available in the tray menu." />

        <TextBlock Grid.Row="15" Style="{StaticResource Label}" Text="Show / hide hotkey" />
        <TextBox   Grid.Row="15" Grid.Column="1" Text="{Binding ToggleHotkey, UpdateSourceTrigger=LostFocus}"
                   ToolTip="e.g. Ctrl+Alt+B, Win+Shift+F9. Applies when you leave the field." />

        <CheckBox  Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2" Content="Always on top" IsChecked="{Binding AlwaysOnTop}" />
        <CheckBox  Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="2" Content="Show in taskbar" IsChecked="{Binding ShowInTaskbar}" />

        <!-- Data: where derived prices get their conversion leg -->
        <TextBlock Grid.Row="18" Grid.ColumnSpan="3" Style="{StaticResource Section}" Text="CONVERSION RATES" />

        <TextBlock Grid.Row="19" Style="{StaticResource Label}" Text="Crypto rates from" />
        <ComboBox  Grid.Row="19" Grid.Column="1" ItemsSource="{Binding RateProviderOptions}" SelectedValue="{Binding RateProvider}"
                   SelectedValuePath="Id" DisplayMemberPath="DisplayName" />
        <TextBlock Grid.Row="20" Style="{StaticResource Label}" Text="If that fails" />
        <ComboBox  Grid.Row="20" Grid.Column="1" ItemsSource="{Binding RateProviderOptions}" SelectedValue="{Binding RateFallback}"
                   SelectedValuePath="Id" DisplayMemberPath="DisplayName" />
        <TextBlock Grid.Row="21" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Note}"
                   Text="Used when no market quotes a pair directly: Tesla in BTC is TSLA/USD ÷ BTC/USD, BTC/DOGE is BTC/USD ÷ DOGE/USD. The line's own provider supplies the first leg, these supply the second. Rates between currencies (USD/CAD) always come from Yahoo Finance." />

        <!-- Alerts -->
        <TextBlock Grid.Row="22" Grid.ColumnSpan="3" Style="{StaticResource Section}" Text="ALERTS" />
        <CheckBox  Grid.Row="23" Grid.Column="1" Grid.ColumnSpan="2" Content="Windows notification when an alert fires" IsChecked="{Binding ToastsEnabled}"
                   ToolTip="The row is highlighted either way." />
        <Button    Grid.Row="23" Grid.Column="0" Style="{StaticResource PlainButton}" Content="Manage alerts…" Command="{Binding OpenAlertsCommand}"
                   HorizontalAlignment="Left" Margin="0,4,16,4" />

        <!-- News popup -->
        <TextBlock Grid.Row="24" Grid.ColumnSpan="3" Style="{StaticResource Section}" Text="NEWS" />

        <TextBlock Grid.Row="25" Style="{StaticResource Label}" Text="Headlines shown" />
        <TextBox   Grid.Row="25" Grid.Column="1" Text="{Binding NewsCount, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="25" Grid.Column="2" Style="{StaticResource Value}" Text="newest first" TextAlignment="Left" />

        <TextBlock Grid.Row="26" Style="{StaticResource Label}" Text="Refresh every" />
        <TextBox   Grid.Row="26" Grid.Column="1" Text="{Binding NewsRefreshMinutes, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="26" Grid.Column="2" Style="{StaticResource Value}" Text="minutes" TextAlignment="Left" />

        <TextBlock Grid.Row="27" Style="{StaticResource Label}" Text="Open headlines in" />
        <ComboBox  Grid.Row="27" Grid.Column="1" ItemsSource="{Binding NewsOpenOptions}" SelectedValue="{Binding NewsOpenIn}"
                   SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                   ToolTip="The reader is an Edge (WebView2) page inside the widget; it uses a fair amount of memory while open." />

        <!-- Feeds: the catalog plus the user's own, three to a row -->
        <!-- Feeds by sector. Each section folds; sections with something switched on start open. -->
        <ItemsControl Grid.Row="28" Grid.ColumnSpan="3" ItemsSource="{Binding FeedGroups}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NewsFeedGroup}">
                    <Expander IsExpanded="{Binding IsExpanded}" Style="{StaticResource SectionExpander}">
                        <Expander.Header>
                            <TextBlock>
                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding Summary, Mode=OneWay}" Foreground="#FF9AA3B2" />
                            </TextBlock>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Options}" Margin="18,2,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NewsFeedOption}">
                                    <!-- on/off · name (click to rename, applies when you leave the box) · country tag · remove -->
                                    <DockPanel LastChildFill="True" Margin="0,0,8,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding RemoveCommand}" Content="&#xE711;"
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="4,2" ToolTip="Remove this feed"
                                                FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.7}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" Foreground="#FF9AA3B2" Margin="4,0" VerticalAlignment="Center"
                                                   FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.75}" />
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" ToolTip="{Binding Tooltip}" Margin="0,3,4,3" />
                                        <TextBox Style="{StaticResource InlineEdit}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Tooltip}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="29" Style="{StaticResource Label}" Text="Add a feed" />
        <DockPanel Grid.Row="29" Grid.Column="1" LastChildFill="True">
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding SectorOptions}" SelectedValue="{Binding NewFeedSector}" SelectedValuePath="Id"
                      DisplayMemberPath="DisplayName" MinWidth="120" Margin="8,4,0,4" ToolTip="Sector the new feed is filed under" />
            <TextBox Text="{Binding NewFeedUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="RSS or Atom feed address">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding AddFeedCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <Button    Grid.Row="29" Grid.Column="2" Style="{StaticResource PlainButton}" Content="Add" Command="{Binding AddFeedCommand}" Margin="12,4,0,4" />
        <DockPanel Grid.Row="30" Grid.Column="1" Grid.ColumnSpan="2" LastChildFill="True">
            <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Restore default feeds" Command="{Binding RestoreDefaultFeedsCommand}"
                    Margin="12,2,0,6" VerticalAlignment="Top" ToolTip="Adds back any shipped feed you removed. Feeds you edited or added are left alone." />
            <TextBlock Style="{StaticResource Note}"
                       Text="Feeds are stored in %LocalAppData%\BtcWidget\feeds.json: edit it to change URLs, sector or country tags, reorder, or set a badge colour. Tags: country code, plus language when not English (ko, ja, de). Right-click a headline to copy its link, visit the site or hide that source." />
        </DockPanel>

        <Button Grid.Row="31" Grid.Column="1" Grid.ColumnSpan="2" Content="Close" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" Padding="18,5" Margin="0,16,0,0" />
    </Grid>
    </ScrollViewer>
</Window>
