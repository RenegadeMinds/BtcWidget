<Window x:Class="BtcWidget.Views.AlertsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BtcWidget.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AlertsViewModel, IsDesignTimeCreatable=True}"
        Title="Alerts"
        Width="620" Height="460" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="#FF202329" Foreground="#FFECEFF4">

    <!--
        One composer at the top: which line, what condition, what value. Below it every rule on every line,
        each with an on/off switch and a remove button. The same rules are also reachable per line from the
        Lines dialog (bell button); both edit LineConfig.Alerts in place.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#FF9AA3B2" />
        <SolidColorBrush x:Key="Field" Color="#FF2A2E37" />
        <SolidColorBrush x:Key="FieldBorder" Color="#FF3A3F4A" />

        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize}" />
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF7931A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.85}" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.92}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFECEFF4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.85}" />
            <Setter Property="Padding" Value="5,3" />
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#FFF7931A" />
            <Setter Property="Foreground" Value="#FF1B1E26" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFA940" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Foreground" Value="#FFECEFF4" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9AA3B2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- NEW ALERT -->
            <RowDefinition Height="Auto" />   <!-- composer -->
            <RowDefinition Height="Auto" />   <!-- hint -->
            <RowDefinition Height="Auto" />   <!-- YOUR ALERTS -->
            <RowDefinition Height="*" />      <!-- list -->
            <RowDefinition Height="Auto" />   <!-- footer -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Section}" Text="NEW ALERT" Margin="0,0,0,8" />

        <!-- When [line] [condition] [value] [unit]   [Add]. Enter in the value box adds. -->
        <DockPanel Grid.Row="1" LastChildFill="False" IsEnabled="{Binding HasLines}">
            <TextBlock DockPanel.Dock="Left" Text="When" Margin="0,0,8,0" />
            <ComboBox DockPanel.Dock="Left" x:Name="LineBox" MinWidth="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=15}"
                      ItemsSource="{Binding LineChoices}" SelectedItem="{Binding SelectedLine}" DisplayMemberPath="Label" />
            <ComboBox DockPanel.Dock="Left" Margin="8,0,0,0" MinWidth="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=11}"
                      ItemsSource="{Binding AlertTypes}" SelectedItem="{Binding NewAlertType}" DisplayMemberPath="Label" />
            <TextBox DockPanel.Dock="Left" x:Name="ValueBox" Margin="8,0,0,0" Padding="8,4" VerticalContentAlignment="Center"
                     Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=7}"
                     Background="{StaticResource Field}" Foreground="#FFECEFF4" BorderBrush="{StaticResource FieldBorder}" CaretBrush="#FFECEFF4"
                     Text="{Binding NewAlertValue, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding NewAlertNeedsValue, Converter={StaticResource BoolToVisibility}}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock DockPanel.Dock="Left" Text="{Binding NewAlertUnit}" Foreground="{StaticResource Muted}" Margin="6,0,0,0"
                       Visibility="{Binding NewAlertNeedsValue, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Add alert" Command="{Binding AddCommand}" Margin="12,0,0,0" />
        </DockPanel>

        <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" Text="{Binding Hint}" Margin="0,8,0,0" />

        <TextBlock Grid.Row="3" Style="{StaticResource Section}" Text="YOUR ALERTS" Margin="0,18,0,8" />

        <Grid Grid.Row="4">
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Top"
                       Text="No alerts yet. Pick a line and a condition above, or right-click a line in the widget."
                       Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityInverse}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AlertEntryViewModel}">
                            <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="4" Background="{StaticResource Field}"
                                    BorderBrush="{StaticResource FieldBorder}" BorderThickness="1">
                                <DockPanel LastChildFill="True">
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" Margin="0,0,10,0" ToolTip="On / off" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="&#xE74D;" ToolTip="Remove"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <StackPanel>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding LineLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Text, Mode=OneWay}" />
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding State}" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.8}" />
                                            <TextBlock Style="{StaticResource MutedText}" Text=" · " FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.8}" />
                                            <!-- Per-rule override of "restore the widget when an alert fires"; click cycles default / yes / no -->
                                            <Button Command="{Binding CycleRestoreCommand}" ToolTip="{Binding RestoreTooltip}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}"
                                                    AutomationProperties.Name="{Binding RestoreText}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock x:Name="T" Text="{Binding RestoreText}" Foreground="{StaticResource Muted}" TextDecorations="Underline"
                                                                   FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.8}" />
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="T" Property="Foreground" Value="#FFECEFF4" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="5" Margin="0,14,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Close" IsCancel="True" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Open log" Command="{Binding OpenLogCommand}"
                    ToolTip="Every alert that fired, with whether a notification went out" />
            <CheckBox Content="Windows notification when an alert fires" IsChecked="{Binding ToastsEnabled}" />
        </DockPanel>
    </Grid>
</Window>
