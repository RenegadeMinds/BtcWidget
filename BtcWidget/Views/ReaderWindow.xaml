<Window x:Class="BtcWidget.Views.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Reader"
        Width="900" Height="700" MinWidth="400" MinHeight="300"
        WindowStyle="SingleBorderWindow" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="#FF202329" Foreground="#FFECEFF4">

    <!--
        Built-in reader: a plain WebView2 (Edge) page with a thin toolbar. One window is reused while it is
        open; closing it also ends the browser processes, which is where the memory goes (~100 MB+), which
        is why the default is the system browser.
    -->
    <Window.Resources>
        <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="6,4">
            <Button Style="{StaticResource Tool}" Content="&#xE72B;" ToolTip="Back" Click="Back_Click" x:Name="BackButton" />
            <Button Style="{StaticResource Tool}" Content="&#xE72A;" ToolTip="Forward" Click="Forward_Click" x:Name="ForwardButton" />
            <Button Style="{StaticResource Tool}" Content="&#xE72C;" ToolTip="Reload" Click="Reload_Click" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Tool}" Content="&#xE8A7;" ToolTip="Open in your browser" Click="OpenExternal_Click" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Tool}" Content="&#xE706;" ToolTip="Light / dark pages" Click="Theme_Click" x:Name="ThemeButton" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Tool}" Content="&#xE8C8;" ToolTip="Copy link" Click="CopyLink_Click" />
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" Foreground="#FF9AA3B2" />
        </DockPanel>
        <Grid>
            <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="White" />
            <TextBlock x:Name="Fallback" Visibility="Collapsed" Margin="24" TextWrapping="Wrap" Foreground="#FF9AA3B2" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
        </Grid>
    </DockPanel>
</Window>
