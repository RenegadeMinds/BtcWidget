<Window x:Class="BtcWidget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BtcWidget.ViewModels"
        xmlns:ctl="clr-namespace:BtcWidget.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
        Title="{Binding Title}"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        SizeToContent="Height"
        MinWidth="220" MaxWidth="1600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="{Binding ShowInTaskbar}"
        Topmost="{Binding AlwaysOnTop}"
        FontSize="{Binding FontSize}"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        d:Width="320" d:Height="220">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
        <!-- Secondary text: 80% of the widget font, muted. Everything scales with the Font size setting. -->
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.8}" />
        </Style>
    </Window.Resources>

    <!--
        Layout: one rounded panel. The panel's background brush carries WindowOpacity;
        the content grid carries TextOpacity, so the two sliders are independent.
        Width is resizable by dragging the left or right edge (ResizeMode=CanResize + the two grips
        below); height always follows content.
    -->
    <Grid>
        <Border x:Name="Panel" CornerRadius="10" BorderThickness="1" Margin="6"
                MouseLeftButtonDown="Panel_MouseLeftButtonDown">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource PanelColor}" Opacity="{Binding WindowOpacity}" />
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="{StaticResource PanelBorderColor}" Opacity="{Binding WindowOpacity}" />
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.4" />
            </Border.Effect>

            <Grid Opacity="{Binding TextOpacity}" Margin="10,6,8,8" TextElement.Foreground="{StaticResource TextBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- title bar -->
                    <RowDefinition Height="Auto" />   <!-- price rows -->
                    <RowDefinition Height="Auto" />   <!-- footer -->
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- News: toggles the headline popup; lit while there are headlines newer than the last look -->
                        <Button Command="{Binding OpenNewsCommand}" ToolTip="News" Content="&#xF57E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnreadNews}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Bell: opens the Alerts dialog; lit while an alert is waiting to be clicked away -->
                        <Button Command="{Binding OpenAlertsCommand}" ToolTip="Alerts" Content="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPendingAlerts}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ManageLinesCommand}"
                                ToolTip="Add or remove lines" Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}"
                                ToolTip="Refresh now" Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Button Style="{StaticResource IconButton}" Command="{Binding OpenSettingsCommand}"
                                ToolTip="Settings" Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <!-- About: version, links, update check; lit while a newer release exists -->
                        <Button Command="{Binding OpenAboutCommand}" ToolTip="{Binding AboutTooltip}" Content="&#xE897;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding MinimizeCommand}"
                                ToolTip="Minimize" Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Button Style="{StaticResource IconButton}" Command="{Binding CloseCommand}"
                                ToolTip="Close" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" />
                </DockPanel>

                <!-- One row per line. The list scrolls once it is taller than the List height setting
                     (drag the bottom edge, or the slider in Settings; 0 = grow with content). -->
                <!-- IsSharedSizeScope keeps every column aligned across rows: price, change, and the detail line's parts -->
                <ScrollViewer x:Name="List" Grid.Row="1" Margin="0,4,0,2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" PanningMode="VerticalOnly"
                              MaxHeight="{Binding ListHeight, Converter={StaticResource MaxHeight}}">
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PriceRowViewModel}">
                            <Button Command="{Binding OpenCommand}" HorizontalContentAlignment="Stretch" Padding="4,3"
                                    ToolTip="{Binding Tooltip}">
                                <!-- Right-click: alerts for this line, open the provider page -->
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Set an alert…" Command="{Binding EditAlertsCommand}" />
                                        <MenuItem Header="{Binding OpenHeader}" Command="{Binding OpenCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <!-- Alerting rows get a faint accent wash until clicked -->
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAlerting}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentFaintBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <!-- Accent bar on the left while an alert is pending -->
                                    <Rectangle Width="2" Fill="{StaticResource AccentBrush}" RadiusX="1" RadiusY="1"
                                               HorizontalAlignment="Left" Margin="-6,1,0,1"
                                               Visibility="{Binding IsAlerting, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel>
                                        <!--
                                            Each line is a DockPanel: fixed parts live in small Grids whose columns share size
                                            groups across every row (so they line up), and the one piece of text that may be
                                            trimmed fills what is left. A Grid that contains shared-size columns measures its
                                            star column as Auto, which is why the trimmed text is kept outside those Grids.
                                        -->
                                        <!-- Line 1: logo . name provider . price . change -->
                                        <DockPanel LastChildFill="True">
                                            <Grid DockPanel.Dock="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Logo" />
                                                </Grid.ColumnDefinitions>
                                                <Image Style="{StaticResource SourceIcon}" Source="{Binding LogoUri}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid DockPanel.Dock="Right">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Price" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Change" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding PriceText}" FontWeight="SemiBold" TextAlignment="Right"
                                                           VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Change, Converter={StaticResource PercentText}}"
                                                           Foreground="{Binding Change, Converter={StaticResource PercentBrush}}"
                                                           MinWidth="56" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <!-- "Bitcoin  Kraken": name, then provider in muted small text; a small bell at the end when alerts are set -->
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{Binding RulesText}"
                                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,2,0"
                                                           FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.7}"
                                                           Visibility="{Binding HasRules, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Text="{Binding ProviderLabel, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"
                                                         FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=0.8}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </DockPanel>

                                        <!-- Line 2: sparkline . 7d . 30d . range -->
                                        <DockPanel LastChildFill="True" Margin="0,2,0,0"
                                                   Visibility="{Binding DataContext.ShowDetails, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                            <Grid DockPanel.Dock="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Logo" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Spark" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label7" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value7" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label30" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value30" />
                                                </Grid.ColumnDefinitions>
                                                <ctl:Sparkline Grid.Column="1" Margin="0,1,10,0" VerticalAlignment="Center"
                                                               Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=4.3}"
                                                               Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize, Converter={StaticResource Scale}, ConverterParameter=1.1}"
                                                               Values="{Binding Series}"
                                                               Stroke="{Binding Change30d, Converter={StaticResource PercentBrush}}" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource Small}" Text="{Binding Label7d}" Margin="0,0,4,0" />
                                                <TextBlock Grid.Column="3" Style="{StaticResource Small}" TextAlignment="Right" Margin="0,0,10,0"
                                                           Text="{Binding Change7d, Converter={StaticResource PercentText1}}"
                                                           Foreground="{Binding Change7d, Converter={StaticResource PercentBrush}}" />
                                                <TextBlock Grid.Column="4" Style="{StaticResource Small}" Text="{Binding Label30d}" Margin="0,0,4,0" />
                                                <TextBlock Grid.Column="5" Style="{StaticResource Small}" TextAlignment="Right" Margin="0,0,10,0"
                                                           Text="{Binding Change30d, Converter={StaticResource PercentText1}}"
                                                           Foreground="{Binding Change30d, Converter={StaticResource PercentBrush}}" />
                                            </Grid>
                                            <TextBlock Style="{StaticResource Small}" Text="{Binding RangeText}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>

                <!-- Footer: status + external links -->
                <DockPanel Grid.Row="2" LastChildFill="True" Margin="4,2,0,0">
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Links}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LinkViewModel}">
                                <Button Style="{StaticResource IconButton}" Command="{Binding OpenCommand}" ToolTip="{Binding Name}" Padding="3">
                                    <Image Style="{StaticResource SourceIcon}" Source="{Binding IconUri}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Small}" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- Invisible resize grips on the left and right edges (the 6px shadow margin plus the panel border) -->
        <Border Width="8" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWE" Margin="0,12"
                MouseLeftButtonDown="LeftGrip_MouseLeftButtonDown" />
        <Border Width="8" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Margin="0,12"
                MouseLeftButtonDown="RightGrip_MouseLeftButtonDown" />
        <!-- Bottom edge: drag to set the list height (the list scrolls beyond it); double-click to go back to auto -->
        <Border Height="8" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNS" Margin="12,0"
                ToolTip="Drag to set the list height. Double-click for automatic height."
                MouseLeftButtonDown="BottomGrip_MouseLeftButtonDown" />
    </Grid>
</Window>
