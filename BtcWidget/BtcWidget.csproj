<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BtcWidget</RootNamespace>
    <AssemblyName>BtcWidget</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.4.1</Version>
    <Product>BtcWidget</Product>
    <AssemblyTitle>BtcWidget</AssemblyTitle>
    <Description>Always-available desktop widget for crypto and stock prices, alerts and news.</Description>
    <Copyright>Copyright (c) 2025-2026 Ryan Smyth / Renegade Minds</Copyright>
    <Authors>Ryan Smyth / Renegade Minds</Authors>
    <RepositoryUrl>https://github.com/RenegadeMinds/BtcWidget</RepositoryUrl>
    <PackageProjectUrl>https://github.com/RenegadeMinds/BtcWidget</PackageProjectUrl>
    <PackageLicenseExpression>WTFPL</PackageLicenseExpression>
    <!-- Single-file publish: unpack the native SQLite / WebView2 loaders beside the exe at first run -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Idle widget: skip the background GC thread, keep heap small. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Built-in reader window (Settings → News → open in). Uses the Edge WebView2 runtime that ships with Windows 11. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- Lift the transitive native SQLite past the version NuGet flags (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <!-- Starter data, copied beside the exe and also embedded (so a single-file exe needs no folder);
         the user's copy lives in %LocalAppData%\BtcWidget -->
    <None Include="Data\*.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Data\*.json" LogicalName="BtcWidget.Data.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
